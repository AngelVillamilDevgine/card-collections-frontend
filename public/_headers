# Cabeceras que pone Cloudflare Pages. No hay nada equivalente en desarrollo: con
# `npm run dev` este archivo no se lee, así que lo que se rompa acá se ve recién en
# producción. Por eso las reglas son las mínimas que la app necesita, y cada una dice
# contra qué protege.
#
# Lo que hace que esto importe: el token de sesión vive en localStorage treinta días y
# no se puede revocar desde la app. Cualquier XSS —propio o de una dependencia que se
# comprometa mañana— se lleva la cuenta entera, no una pantalla.

/*
  # De dónde puede salir cada cosa. 'self' es cromeros.com.ar.
  #
  #  script-src sin 'unsafe-inline' ni 'unsafe-eval': se verificó sobre el build que
  #    Vite no deja ningún <script> inline, sólo el módulo con hash. Si algún día lo
  #    dejara, la app deja de arrancar en producción y anda en dev — ojo con eso.
  #  style-src necesita 'unsafe-inline' y no se puede evitar: las bandas de cada
  #    expansión se pintan con style={{ background: exp.color }}, que es un atributo
  #    de estilo en línea. Es la concesión conocida de React, y es mucho menos grave
  #    que la de script.
  #  connect-src tiene que nombrar la API: vive en api.cromeros.com.ar, que es otro
  #    origen, así que 'self' no la cubre.
  #  frame-ancestors 'none' es lo que impide que alguien la meta en un iframe y te
  #    robe los clicks.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.cromeros.com.ar; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

  # Para los navegadores que no miran frame-ancestors. Las dos conviven a propósito.
  X-Frame-Options: DENY

  # Que no adivine el tipo de un archivo por su contenido. Sin esto, algo servido como
  # texto puede terminar ejecutándose como script.
  X-Content-Type-Options: nosniff

  # A otros sitios se les cuenta el origen y nada más: nunca la dirección completa.
  Referrer-Policy: strict-origin-when-cross-origin

  # La primera visita es la única ventana que HSTS cierra: alguien escribe
  # cromeros.com.ar en el navegador, eso sale como http:// y recién ahí lo redirigen a
  # https. Quien esté en el medio de ese primer viaje —un wifi público, un router
  # comprometido— se queda con todo, y en esta app «todo» incluye la clave de la cuenta.
  # Con esta cabecera, el navegador se acuerda por un año y ya nunca intenta el http.
  #
  # Tres decisiones, las tres a propósito:
  #
  #  · Sin `preload`. Eso mete el dominio en una lista que viene cocinada adentro del
  #    navegador, y sacarlo después lleva meses: es una puerta de una sola dirección y
  #    no hace falta cruzarla para tener el beneficio.
  #  · Sin `includeSubDomains`. Comprometería a TODO subdominio futuro de
  #    cromeros.com.ar a ser https por un año, incluso a uno que todavía no existe y que
  #    algún día apunte a otra cosa. Los tres que existen hoy (el dominio, www y api)
  #    mandan la cabecera cada uno por su cuenta, que da lo mismo y no compromete nada.
  #  · Un año, que es el valor estándar. Para dar marcha atrás se pone max-age=0 y se
  #    espera a que los navegadores que ya la vieron la vuelvan a pedir.
  Strict-Transport-Security: max-age=31536000

  # La app no usa nada de esto. Apagarlo de entrada vale para el día en que una
  # dependencia lo intente.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()
